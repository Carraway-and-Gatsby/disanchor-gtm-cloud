# Load explicitly in the Cloud process environment; never commit real values.
UPLOAD_POST_API_KEY=
# Short-lived GA4 bearer token; refresh externally with a least-privilege service account.
GA4_ACCESS_TOKEN=
# Preferred on Cloud: private service-account JSON, analytics.readonly access.
GOOGLE_APPLICATION_CREDENTIALS=
CLONE_APP_KEY=
CLONE_USER_ID=
# Dedicated read-only Telegram monitoring bot; private chat only.
# Bot token is a secret; CHAT_ID and USER_ID must identify the same private owner.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
# Hermes provider authentication is configured separately on the Cloud runtime.
# No credentials required for tests or `dry-run`.
